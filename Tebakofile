# Feedstock recipe for node
# spec 13 §9 + docs/conventions.md in tebako-packages/index
name: "node"
kind: runtime
summary: "Node.js (official prebuilt distributions) — tebako node RUNTIME pairs (wrapper exe + env image); the hermetic javascript engine"

# The spec 28 §8 implementation axis: ONE recipe, flavored sources. node
# ships a single implementation today — the official Node.js
# distribution — so `official` is the default (and only) flavor; every
# default resolution channel points here. The axis exists so a future
# distribution variant (a fork line, a scenario build) slots in without a
# recipe-shape change.
flavors:
  official:
    implementation: "node"
    language_version: "24"           # the node language line (NODE_MAJOR_VERSION)
    abi_line: "137"                  # NODE_MODULE_VERSION of the v24 line — the native-addon ABI grammar (verified against src/node_version.h of the pinned tarball)
    interpreter_api_version: "24"    # layout.yaml's required declared line (the "3.4"-style line; node: the major)
    # The staged tree's spawn surface: bin/node plus the npm/npx/corepack
    # shims. Upstream stages those three as symlinks into
    # lib/node_modules/...; the v2.8.22 limnifs writer has no link node
    # type (a symlink would land as a 0-byte regular-file node), so
    # tools/build dereferences them — the name surface stays upstream's,
    # the bytes are the target's (the openjdk precedent). On windows
    # those three ship as .cmd shims; exec of
    # a .cmd through the runtime boot is exercised at the factory dogfood,
    # so the windows leg declares the platform-true surface until then
    # (the graalvm entrypoints_windows_drop precedent).
    entrypoints: [node, npm, npx, corepack]
    entrypoints_windows_drop: [npm, npx, corepack]
    upstream:
      # Node.js 24.21.0 (LTS Krypton) — one binary source per platform
      # (repack: no compilation). platform is the spec 03 triplet;
      # strip_components is the nesting depth of the payload root inside
      # the archive (every node dist nests under one dir; the windows zip
      # stages node.exe + the .cmd shims at its root).
      # Digests verified against nodejs.org SHASUMS256.txt 2026-09-26.
      version: "24.21.0"
      sources:
        - platform: "aarch64-macos"
          url: "https://nodejs.org/dist/v24.21.0/node-v24.21.0-darwin-arm64.tar.gz"
          sha256: "bed7eea5325e1108f32ce5228ddd6a5f0f08a499ee42aa7442aea583702f6057"
          strip_components: 1
        - platform: "x86_64-macos"
          url: "https://nodejs.org/dist/v24.21.0/node-v24.21.0-darwin-x64.tar.gz"
          sha256: "1462cb3b3046b815cf8ea436d3da450ec1a9f11dac7e5a46b0ada5305d7e8097"
          strip_components: 1
        - platform: "x86_64-linux-gnu"
          url: "https://nodejs.org/dist/v24.21.0/node-v24.21.0-linux-x64.tar.gz"
          sha256: "6e1db87ef58b8819e5d5402eff1536491b18edd8eb7bee5ef7897876e88dc5ff"
          strip_components: 1
        - platform: "aarch64-linux-gnu"
          url: "https://nodejs.org/dist/v24.21.0/node-v24.21.0-linux-arm64.tar.gz"
          sha256: "724282c3b43aec998aa9527380465b45d229e021b58035f5f4f63095eabfe5d5"
          strip_components: 1
        # The musl legs: nodejs.org ships no musl build — these come from
        # unofficial-builds.nodejs.org (the docker-node provenance). The
        # manifest's source/provenance keys record the non-upstream
        # origin; resolution picks them by triplet, never by selector.
        - platform: "x86_64-linux-musl"
          url: "https://unofficial-builds.nodejs.org/download/release/v24.21.0/node-v24.21.0-linux-x64-musl.tar.gz"
          sha256: "01a713e34da98e7b4d2a3191ee7ca3f93dd0384d1a2ef23c379b2161ee6e133a"
          strip_components: 1
        - platform: "aarch64-linux-musl"
          url: "https://unofficial-builds.nodejs.org/download/release/v24.21.0/node-v24.21.0-linux-arm64-musl.tar.gz"
          sha256: "3048b0811e158ca0d8672b59c839861763e144492980d8d29b369dfee45747e4"
          strip_components: 1
        - platform: "x86_64-windows-ucrt"
          url: "https://nodejs.org/dist/v24.21.0/node-v24.21.0-win-x64.zip"
          sha256: "158f7685b44de51f6c0df1d153526cbcd3e1bc739a8dfc607721cef75de9e541"
          strip_components: 1
        # aarch64-windows-ucrt (node-v24.21.0-win-arm64.zip, upstream
        # official since the v20 line) lands when the tebako product
        # ships tebako-runtime-launcher for windows-ucrt-arm64 — the pair
        # needs its wrapper exe, and v2.8.22 publishes seven platforms.

build:
  system: repack          # no compilation: unpack, prune, image
  deps: []

# The runtime contract (spec 28 revised §8 + spec 29). tools/build renders
# manifests/runtime.yaml (tier-1, embedded at /__tpkg__/manifest.yaml) and
# manifests/layout.yaml (the driver pair contract, /lib/tebako/layout.yaml)
# from this block + the selected flavor's block — the feedstock's SSOT for
# the pair's declared identity.
runtime:
  engine: "node"
  contract_version: 2              # the spec 17 driver contract the wrapper speaks
  interpreter: "/bin/node"         # POSIX legs: the staged tree's bin/node
  interpreter_windows: "/node.exe" # the windows zip stages node.exe at the payload root
  # visibility key ABSENT in the rendered layout (spec 29 §3's locked
  # default order): preload on POSIX (node is a dynamic interpreter),
  # exec-cache on windows — journaled at boot, never a silent fallback.
  mount_root_override: false       # closed default — node self-locates its home from the interpreter path (bin/..); granting a no-op knob violates spec 00 §9
  # The tebako product line the pair builds against: the wrapper exe
  # (tebako-runtime-launcher) and the preload shim (link-unit). The line
  # number names the artifacts (tebako-runtime-2.8.22-node-24.21.0-*
  # since tebako#716 — the flavor's implementation segment) and the
  # release tag (v2.8.22 — the trr convention: the tag IS the tebako
  # line).
  #
  # v2.8.22 (2026-09-28) is the current product line and the first pin of
  # this factory: it carries every contract the pair speaks — spec 29's
  # wrapper pattern, spec 32's executable requires edges, spec 33's
  # on_runtime composition, and the mount-ancestor routes the flavors
  # mechanism mounts through — plus ruby-4.0.7 press support downstream.
  wrapper_tebako: "2.8.22"
  # The wrapper's trust anchor, per tool-platform (the launcher is the
  # shipped runtime pair's process entry point — an unauthenticated
  # download would be a supply-chain hole). Digests are the v2.8.22
  # release's monolith SHA256SUMS entries, fetched 2026-09-29.
  wrapper_sha256:
    macos-arm64: "6491565e8e75a8e2776a75d4f03875db8a978e94b1d244c43649b773015552c6"
    macos-x86_64: "d9e901cdba292344870c1834c0fe737a14125acc45273721b19cde03b0f772af"
    linux-gnu-x86_64: "5882c74710db287ac6e73c0d5c09afdfd696555da4ede5aad1c6b6e0b6235013"
    linux-gnu-arm64: "e27befc2dcc5f00390b6bdf67bd4cfda0adbca53fbc363902e4423a0b852c91f"
    linux-musl-x86_64: "ead432a28233adf5b5df3625c7a49caa1178d1592aaacdb11c248cb33775fbc9"
    linux-musl-arm64: "b3fe4b910b5c965276c0840f7bb7910c1f8cc238324d66fc8d4c8739718d1e48"
    windows-ucrt64: "afe65d91b046d829fbc9b7e9ae4de8cbc76290021274cb899b25dc2e6339bda3"

# Factory tools used by tools/build (the imager + the preload shim): the
# tfs CLI and the link-unit tarball from the tamatebako/tebako release.
# The asset digests are pinned HERE — tools.sha256 is the repo's
# toolchain pin SSOT (the workflow carries no version or digest literals;
# tools/pins.rb reads this block into $GITHUB_ENV). The tfs pins are
# cross-checked against the release's SHA256SUMS at fetch time; the
# link-unit tarballs are NOT in that monolith, so these pins are their
# single trust anchor (verified against the v2.8.22 downloads 2026-09-29).
tools:
  repo: "tamatebako/tebako"
  release: "v2.8.22"
  # The release machinery pin: the tamatebako/tebako-release-tooling tag
  # the Gemfile resolves (the sign step's tebako-release exe). The gem is
  # the signer's single owner (ecosystem invariant 10) — this feedstock
  # carries no copy of it.
  #
  # v0.5.1: tebako#716's dual-era package-name grammar (on the v0.5.0
  # seam; v0.5.1 is the publish-leg convergence hardening on top). This
  # feedstock's sign pass is adapter-less and composes no names
  # (SIGN_ONLY_STEMS flows pins.rb's stem), so the bump is transparent —
  # it keeps the tooling line on the gem every sibling factory pins.
  release_tooling: "v0.5.1"
  sha256:
    tfs:
      macos-arm64: "08f201f20e808dc0d4253e1617a3dc549a1a316132fdce9d81457645049d2eda"
      macos-x86_64: "78ada85085d54eb9094d58e2ca468a768433bd7a45dddebfe60345ccf859b9a4"
